<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLand"
        Width="480" Height="310"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable, Segoe UI"
        SourceInitialized="Window_SourceInitialized">

    <!-- The window is sized for the biggest card; the shapes inside are what grow and shrink.
         Transparent areas let mouse clicks pass through to the apps underneath.
         Layout, left to right: [performance bubble] [main capsule / card] [activity bubble].
         The alert strip sits under the main capsule. -->
    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Performance bubble (optional, off by default): concentric rings or one CPU ring -->
        <Border x:Name="PerfBubble" Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                Background="Black" Margin="0,0,8,0" VerticalAlignment="Top" Visibility="Collapsed"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PerfBubbleScale" />
            </Border.RenderTransform>
            <Grid x:Name="PerfBubbleHost" />
        </Border>

        <StackPanel Grid.Column="1">
        <Border x:Name="Pill"
                Background="Black"
                Width="232" Height="32"
                CornerRadius="16"
                HorizontalAlignment="Center"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown"
                MouseMove="Pill_MouseMove"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave">
            <Grid ClipToBounds="True">

                <!-- Music card background: a soft teal wash behind the player -->
                <Border x:Name="MusicCardBg" Opacity="0" IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Pill}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F5757" Offset="0" />
                            <GradientStop Color="#0B3B3B" Offset="0.55" />
                            <GradientStop Color="#07201F" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- PC stats: one row of icon + percentage. Centred in the small idle pill; along the bottom of the
                     standard pill while something is active, so the readings never disappear. -->
                <StackPanel x:Name="StatsView" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                            Opacity="0" IsHitTestVisible="False"
                            TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold"
                            Typography.NumeralAlignment="Tabular">
                    <!-- Icons are 12x12 vector shapes; strokes sit on half pixels to stay crisp. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,13,0" ToolTip="CPU">
                        <Path Width="12" Height="12" Stroke="#9A9AA3" StrokeThickness="1" VerticalAlignment="Center"
                              Data="M3.5,3.5 H8.5 V8.5 H3.5 Z M4.5,1 V3.5 M7.5,1 V3.5 M4.5,8.5 V11 M7.5,8.5 V11 M1,4.5 H3.5 M1,7.5 H3.5 M8.5,4.5 H11 M8.5,7.5 H11" />
                        <TextBlock x:Name="CpuValue" Text="--" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,13,0" ToolTip="Memory">
                        <Path Width="12" Height="12" Stroke="#9A9AA3" StrokeThickness="1" VerticalAlignment="Center"
                              Data="M0.5,3.5 H11.5 V8.5 H0.5 Z M2.5,8.5 V10.5 M5.5,8.5 V10.5 M8.5,8.5 V10.5" />
                        <TextBlock x:Name="RamValue" Text="--" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="GpuItem" Orientation="Horizontal" Margin="0,0,13,0" ToolTip="GPU">
                        <Path Width="12" Height="12" Stroke="#9A9AA3" StrokeThickness="1" VerticalAlignment="Center"
                              Data="M0.5,2.5 H11.5 V9.5 H0.5 Z M8,6 A2,2 0 1 1 4,6 A2,2 0 1 1 8,6 Z" />
                        <TextBlock x:Name="GpuValue" Text="--" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="BatteryItem" Orientation="Horizontal" Visibility="Collapsed" ToolTip="Battery">
                        <Grid Width="12" Height="12" VerticalAlignment="Center">
                            <Path Stroke="#9A9AA3" StrokeThickness="1"
                                  Data="M0.5,3.5 H9.5 V8.5 H0.5 Z M9.5,5 H11 V7 H9.5" />
                            <!-- Bolt, shown while plugged in -->
                            <Path x:Name="BoltIcon" Fill="White" Visibility="Collapsed"
                                  Data="M5.5,4 L3.5,6.2 H5.2 L4.8,8 L6.8,5.8 H5.1 Z" />
                        </Grid>
                        <TextBlock x:Name="BatteryValue" Text="--" Foreground="White" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Start-up intro: the SkyLand logo pops in, then the name rises in letter by letter -->
                <Grid x:Name="IntroView" Width="270" Height="60"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox x:Name="IntroLogo" Height="30" Margin="0,0,12,0" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Viewbox.RenderTransform>
                                <ScaleTransform x:Name="IntroLogoScale" ScaleX="0.4" ScaleY="0.4" />
                            </Viewbox.RenderTransform>
                            <!-- The SkyLand artwork (skyland-dark.svg), drawn from its original coordinates -->
                            <Canvas Width="501.11" Height="276.14">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="-506.8" Y="-291.96" />
                                </Canvas.RenderTransform>
                                <Path Data="F1 M783.97293,295.83075c0,0 -141.90424,-7.59174 -174.17538,0c-12.95689,3.04809 -19.05778,5.89038 -26.3997,12.81571c-7.37698,6.95843 -12.45152,16.34292 -17.75744,28.83602c-7.49172,17.63966 -18.05221,49.70935 -19.54539,70.1503c-1.1094,15.1874 -0.35552,32.70835 5.31908,40.68919c5.21242,7.33086 25.67446,8.63522 25.67446,8.63522c0,0 103.29774,2.47928 111.46864,1.21748c0.21708,4.08909 -1.26785,8.98054 -1.26785,8.98054l-8.99753,37.00719l-154.44017,-0.90818l-16.55047,61.27186c0,0 146.15053,3.16485 178.11445,1.05642c10.88188,-2.02351 15.17649,-3.264 21.69392,-8.36556c6.05458,-6.38491 12.87272,-12.68787 18.50005,-24.3832c8.99723,-18.699 21.25762,-61.82846 22.85541,-83.4565c0.97419,-13.18701 0.21296,-24.18014 -3.79209,-32.65661c-3.9504,-8.36083 -10.1015,-12.64051 -19.85143,-18.05115c-22.30669,-3.52324 -110.14495,1.73721 -117.94634,-0.87423c-0.75731,-1.38147 0.16162,-5.0416 0.16162,-5.0416l7.01057,-30.38411c0,0 0.86324,-3.47758 2.55154,-5.0104c10.46044,-2.55499 152.3623,0.07715 152.3623,0.07715z" Fill="#2563eb" Stroke="#2563eb" StrokeThickness="1" StrokeLineJoin="Round" />
                                <Path Data="F1 M757.6668,567.59583l124.46537,-144.20314l57.35169,73.34043l19.52399,-15.85741l48.4032,58.47413l-46.7762,-30.22815l-29.69272,26.2638l-50.43695,-60.45631l-76.46892,67.88946z" Fill="#ffffff" Stroke="#eeeeee" StrokeThickness="1" StrokeLineJoin="Round" />
                                <Path Data="F1 M940.27426,497.51741l14.70305,16.23414l5.90791,-4.47996l44.20781,27.30574l-45.83861,-55.2604z" Fill="#62abf7" />
                                <Path Data="F1 M881.02019,474.25577c-0.69771,-2.01578 -1.19951,-4.29276 -1.54295,-6.73652c-2.45604,-17.47576 3.18571,-43.48037 3.18571,-43.48037l57.12907,73.11627l15.4282,16.65799l-23.53853,20.69519c0,0 -43.54281,-39.68578 -50.6615,-60.25256z" Fill="#e5effc" />
                            </Canvas>
                        </Viewbox>
                        <!-- The letters of "SkyLand" are added in code so each can be animated -->
                        <StackPanel x:Name="IntroWord" Orientation="Horizontal" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Update prompt: stays until you choose Install or Later; then shows download progress -->
                <Grid x:Name="UpdateView" Width="270" Height="60"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#0A84FF" Margin="20,0,0,0"
                             VerticalAlignment="Center" />

                    <TextBlock x:Name="UpdateText" Grid.Column="1" Margin="9,0,6,0" Foreground="White"
                               FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button x:Name="UpdateInstallButton" Content="Install" FontSize="12"
                                Style="{StaticResource PillButton}" Click="UpdateInstall_Click" Margin="0,0,6,0" />
                        <Button x:Name="UpdateLaterButton" Content="Later" FontSize="12"
                                Style="{StaticResource PillButton}" Click="UpdateLater_Click" />
                    </StackPanel>
                </Grid>

                <!-- Notice: short power pop-up (charger connected / unplugged) -->
                <Grid x:Name="NoticeView" Width="270" Height="60"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="16" Height="16" Margin="22,0,0,0" VerticalAlignment="Center">
                        <Path x:Name="NoticeBolt" Fill="#30D158"
                              Data="M9.5,0.5 L2.5,9 H7.2 L6.2,15.5 L13.5,6.5 H8.8 Z" />
                        <Path x:Name="NoticeBattery" Stroke="White" StrokeThickness="1" Visibility="Collapsed"
                              Data="M1.5,4.5 H12.5 V11.5 H1.5 Z M12.5,6.5 H14.5 V9.5 H12.5" />
                        <!-- Status dot for coding-agent pop-ups -->
                        <Ellipse x:Name="NoticeDot" Width="10" Height="10" Fill="#FFB340" Visibility="Collapsed" />
                    </Grid>

                    <!-- Two lines: what happened, and the detail under it (battery level, project, tool...) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,20,0">
                        <TextBlock x:Name="NoticeTitle" Text="Charging" Foreground="#30D158"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="NoticePercent" Text="--" Foreground="#9A9AA3"
                                   FontSize="12" Margin="0,1,0,0"
                                   Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- ===== Collapsed capsules (44 px high): leading mark, label, trailing value ===== -->

                <!-- Claude Code: status ring around the Claude symbol (or a stack of avatars for several sessions) -->
                <Grid x:Name="ClaudeCapsule" Width="252" Height="44"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="ClaudeLead" Grid.Column="0" Height="28" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ClaudeName" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ClaudeSub" Foreground="#9A9AA3" FontSize="10.5" Margin="0,-1,0,0"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="ClaudeTrail" Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center"
                               FontSize="13.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </Grid>

                <!-- Focus: progress ring with the minutes, "Focus / session 1 of 3", countdown -->
                <Grid x:Name="FocusCompactView" Width="240" Height="44"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="28" Height="28" Margin="14,0,0,0">
                        <Ellipse Stroke="#2A2A2E" StrokeThickness="3" />
                        <Ellipse x:Name="FocusRing" Stroke="#FF6A3D" StrokeThickness="3"
                                 StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="FocusRingMinutes" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FocusTitleSmall" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FocusSubSmall" Foreground="#9A9AA3" FontSize="10.5" Margin="0,-1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock x:Name="FocusCountdownSmall" Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center"
                               Foreground="#FF6A3D" FontSize="13.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                </Grid>

                <!-- Music: artwork, title and artist, equaliser -->
                <Grid x:Name="CompactView" Width="252" Height="44"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ArtSmall" Grid.Column="0" Width="28" Height="28"
                            CornerRadius="8" Margin="14,0,0,0" Background="#2A2A2E" />
                    <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleSmall" Foreground="White" FontSize="13.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistSmall" Foreground="#9A9AA3" FontSize="10.5" Margin="0,-1,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel x:Name="Equaliser" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Height="18" Margin="0,0,16,0">
                        <Rectangle x:Name="Bar1" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="#FF6F8F" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Rectangle x:Name="Bar2" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="#FF6F8F" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Rectangle x:Name="Bar3" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="#FF6F8F" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Rectangle x:Name="Bar4" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="#FF6F8F" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Rectangle x:Name="Bar5" Width="2.5" Height="4" RadiusX="1.25" RadiusY="1.25" Fill="#FF6F8F" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ===== Expanded cards (340 px wide). The PC row (StatsView) sits along the bottom of the main card. ===== -->

                <!-- Claude Code card: every session with its status ring, what it is doing, and the time -->
                <Grid x:Name="ClaudeCard" Width="340" VerticalAlignment="Top" HorizontalAlignment="Center"
                      Opacity="0" IsHitTestVisible="False">
                    <StackPanel Margin="20,18,20,0">
                        <Grid Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="#D97757" VerticalAlignment="Center"
                                  Data="{StaticResource ClaudeSymbol}" />
                            <TextBlock Grid.Column="1" Text="Claude Code" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Border Grid.Column="2" CornerRadius="11" Padding="9,3" Background="#1D1D22"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ClaudeCountText" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" />
                            </Border>
                        </Grid>
                        <StackPanel x:Name="ClaudeList" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Music card: artwork, title, progress, controls -->
                <Grid x:Name="ExpandedView" Width="340" Height="166"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <StackPanel Margin="20,18,20,0">
                        <Grid Height="58">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ArtLarge" Width="58" Height="58" CornerRadius="12" Background="#2A2A2E" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0">
                                <TextBlock x:Name="TitleLarge" Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ArtistLarge" Foreground="#B9D3D3" FontSize="12.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#30FFFFFF"
                                Margin="0,14,0,0" SizeChanged="ProgressTrack_SizeChanged">
                            <Border x:Name="ProgressFill" Width="0" CornerRadius="2" Background="White" HorizontalAlignment="Left" />
                        </Border>
                        <Grid Margin="0,5,0,0">
                            <TextBlock x:Name="CurrentTime" Text="0:00" Foreground="#B9D3D3" FontSize="10.5" HorizontalAlignment="Left" />
                            <TextBlock x:Name="TotalTime" Text="0:00" Foreground="#B9D3D3" FontSize="10.5" HorizontalAlignment="Right" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous" />
                            <Button x:Name="PlayButton" Style="{StaticResource RoundPlayButton}" Content="&#xE769;"
                                    Click="PlayPause_Click" ToolTip="Play / Pause" Margin="12,0" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Next" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Focus card: read-only mirror of Microsoft Clock -->
                <Grid x:Name="FocusPageView" Width="340" Height="122"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="20,16,20,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="80" Height="80">
                            <Ellipse Stroke="#1F1F24" StrokeThickness="7" />
                            <Ellipse x:Name="FocusBigRing" Stroke="#FF6A3D" StrokeThickness="7"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="FocusGlow" Color="#FF6A3D" BlurRadius="12"
                                                      ShadowDepth="0" Opacity="0.45" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="FocusCountdown" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" />
                                <TextBlock x:Name="FocusRingCaption" Text="left" Foreground="#9A9AA3" FontSize="10.5"
                                           HorizontalAlignment="Center" Margin="0,-1,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="FocusChip" HorizontalAlignment="Left" CornerRadius="10" Padding="9,2.5"
                                    Background="#33FF6A3D">
                                <TextBlock x:Name="FocusPhase" FontSize="10.5" FontWeight="Bold" Foreground="#FF6A3D" />
                            </Border>
                            <TextBlock x:Name="FocusTitle" Foreground="White" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FocusSub" Foreground="#9A9AA3" FontSize="12.5"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <StackPanel x:Name="FocusDots" Orientation="Horizontal" Margin="0,9,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- System card (idle island, hovered): four ring gauges, built in code -->
                <Grid x:Name="SystemCard" Width="340" Height="150"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <StackPanel Margin="20,18,20,0">
                        <Grid Height="28">
                            <TextBlock Text="System" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border x:Name="PowerChip" HorizontalAlignment="Right" CornerRadius="11" Padding="9,3"
                                    Background="#1D1D22" VerticalAlignment="Center">
                                <TextBlock x:Name="PowerChipText" FontSize="11" FontWeight="Bold" Foreground="#30D158" />
                            </Border>
                        </Grid>
                        <UniformGrid x:Name="SystemGauges" Rows="1" Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Divider above the PC row at the bottom of the main card -->
                <Rectangle x:Name="StatsDivider" Height="1" Fill="#14FFFFFF" VerticalAlignment="Bottom"
                           Margin="20,0,20,38" Opacity="0" IsHitTestVisible="False" />

            </Grid>
        </Border>

        <!-- Alert strip: a short line under the capsule when the PC is under heavy load or the battery is low -->
        <Border x:Name="AlertStrip" CornerRadius="16" Background="Black" Padding="15,7"
                Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="Collapsed" Opacity="0"
                MinWidth="{Binding ActualWidth, ElementName=Pill}" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="AlertShift" Y="-8" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse x:Name="AlertDot" Width="8" Height="8" Fill="#FF5F7A" VerticalAlignment="Center" />
                <TextBlock x:Name="AlertTitle" Foreground="#FF5F7A" FontSize="12.5" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="AlertDetail" Foreground="#9A9AA3" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Activity bubble: the second most important thing (Claude status, music art with progress, or Focus ring) -->
        <Border x:Name="Bubble" Grid.Column="2" Width="44" Height="44" CornerRadius="22" Background="Black"
                Margin="8,0,0,0" VerticalAlignment="Top" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Pill_MouseLeave" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BubbleScale" />
            </Border.RenderTransform>
            <Grid>
                <Grid x:Name="BubbleClaudeHost" Width="44" Height="44" />
                <Grid x:Name="BubbleMusic" Width="44" Height="44" Visibility="Collapsed">
                    <Ellipse Stroke="#26262C" StrokeThickness="2.4" Width="42" Height="42" />
                    <Ellipse x:Name="BubbleMusicRing" Stroke="#FF6F8F" StrokeThickness="2.4" Width="42" Height="42"
                             StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="BubbleArt" Width="32" Height="32" Fill="#2A2A2E" />
                </Grid>
                <Grid x:Name="BubbleFocus" Width="44" Height="44" Visibility="Collapsed">
                    <Ellipse Stroke="#2A2A2E" StrokeThickness="4" Width="38" Height="38" />
                    <Ellipse x:Name="BubbleFocusRing" Stroke="#FF6A3D" StrokeThickness="4" Width="38" Height="38"
                             StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="BubbleFocusText" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
