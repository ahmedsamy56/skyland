<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island"
        Width="400" Height="140"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable, Segoe UI"
        SourceInitialized="Window_SourceInitialized">

    <!-- The window is sized for the expanded pill; the pill inside is what grows and shrinks.
         Transparent areas let mouse clicks pass through to the apps underneath. -->
    <Grid>
        <Border x:Name="Pill"
                Background="Black"
                Width="200" Height="46"
                CornerRadius="23"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                MouseLeftButtonUp="Pill_MouseLeftButtonUp"
                MouseEnter="Pill_MouseEnter"
                MouseLeave="Pill_MouseLeave">
            <Grid ClipToBounds="True">

                <!-- Idle: PC stats (shown only when no media is playing) -->
                <StackPanel x:Name="StatsView" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False"
                            TextElement.FontSize="11.5" TextElement.FontWeight="SemiBold"
                            Typography.NumeralAlignment="Tabular">
                    <!-- Icons are 12x12 vector shapes; strokes sit on half pixels to stay crisp. -->
                    <!-- Each stat: percentage on top, icon underneath. -->
                    <StackPanel Margin="0,0,16,0" ToolTip="CPU">
                        <TextBlock x:Name="CpuValue" Text="--" Foreground="White" HorizontalAlignment="Center" />
                        <Path Width="12" Height="12" Stroke="#9A9AA3" StrokeThickness="1" Margin="0,4,0,0" HorizontalAlignment="Center"
                              Data="M3.5,3.5 H8.5 V8.5 H3.5 Z M4.5,1 V3.5 M7.5,1 V3.5 M4.5,8.5 V11 M7.5,8.5 V11 M1,4.5 H3.5 M1,7.5 H3.5 M8.5,4.5 H11 M8.5,7.5 H11" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" ToolTip="Memory">
                        <TextBlock x:Name="RamValue" Text="--" Foreground="White" HorizontalAlignment="Center" />
                        <Path Width="12" Height="12" Stroke="#9A9AA3" StrokeThickness="1" Margin="0,4,0,0" HorizontalAlignment="Center"
                              Data="M0.5,3.5 H11.5 V8.5 H0.5 Z M2.5,8.5 V10.5 M5.5,8.5 V10.5 M8.5,8.5 V10.5" />
                    </StackPanel>
                    <StackPanel x:Name="GpuItem" Margin="0,0,16,0" ToolTip="GPU">
                        <TextBlock x:Name="GpuValue" Text="--" Foreground="White" HorizontalAlignment="Center" />
                        <Path Width="12" Height="12" Stroke="#9A9AA3" StrokeThickness="1" Margin="0,4,0,0" HorizontalAlignment="Center"
                              Data="M0.5,2.5 H11.5 V9.5 H0.5 Z M8,6 A2,2 0 1 1 4,6 A2,2 0 1 1 8,6 Z" />
                    </StackPanel>
                    <StackPanel x:Name="BatteryItem" Visibility="Collapsed" ToolTip="Battery">
                        <TextBlock x:Name="BatteryValue" Text="--" Foreground="White" HorizontalAlignment="Center" />
                        <Grid Width="12" Height="12" Margin="0,4,0,0" HorizontalAlignment="Center">
                            <Path Stroke="#9A9AA3" StrokeThickness="1"
                                  Data="M0.5,3.5 H9.5 V8.5 H0.5 Z M9.5,5 H11 V7 H9.5" />
                            <!-- Bolt, shown while plugged in -->
                            <Path x:Name="BoltIcon" Fill="White" Visibility="Collapsed"
                                  Data="M5.5,4 L3.5,6.2 H5.2 L4.8,8 L6.8,5.8 H5.1 Z" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Notice: short power pop-up (charger connected / unplugged) -->
                <Grid x:Name="NoticeView" Width="230" Height="40"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="16" Height="16" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Path x:Name="NoticeBolt" Fill="#30D158"
                              Data="M9.5,0.5 L2.5,9 H7.2 L6.2,15.5 L13.5,6.5 H8.8 Z" />
                        <Path x:Name="NoticeBattery" Stroke="White" StrokeThickness="1" Visibility="Collapsed"
                              Data="M1.5,4.5 H12.5 V11.5 H1.5 Z M12.5,6.5 H14.5 V9.5 H12.5" />
                    </Grid>

                    <TextBlock x:Name="NoticeTitle" Grid.Column="1" Text="Charging" Foreground="#30D158"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />

                    <TextBlock x:Name="NoticePercent" Grid.Column="2" Text="--" Foreground="White"
                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"
                               Typography.NumeralAlignment="Tabular" />
                </Grid>

                <!-- Focus compact: progress ring, countdown, title, session dots (mirrors Microsoft Clock) -->
                <Grid x:Name="FocusCompactView" Width="250" Height="36"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="22" Height="22" Margin="10,0,0,0">
                        <Ellipse Stroke="#2A2A2E" StrokeThickness="3" />
                        <Ellipse x:Name="FocusRing" Stroke="#FF6A3D" StrokeThickness="3"
                                 StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <TextBlock x:Name="FocusCountdownSmall" Grid.Column="1" Margin="8,0,0,0"
                               Foreground="White" FontSize="13" FontWeight="SemiBold"
                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />

                    <TextBlock x:Name="FocusTitleSmall" Grid.Column="2" Margin="8,0"
                               Foreground="#9A9AA3" FontSize="11.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel x:Name="FocusDotsSmall" Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,14,0" />
                </Grid>

                <!-- Focus page (expanded): read-only mirror of Microsoft Clock -->
                <Grid x:Name="FocusPageView" Width="310" Height="116"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="20,0,20,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Progress ring with the countdown inside -->
                        <Grid Grid.Column="0" Width="80" Height="80">
                            <Ellipse Stroke="#1F1F24" StrokeThickness="7" />
                            <Ellipse x:Name="FocusBigRing" Stroke="#FF6A3D" StrokeThickness="7"
                                     StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="FocusGlow" Color="#FF6A3D" BlurRadius="12"
                                                      ShadowDepth="0" Opacity="0.45" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="FocusCountdown" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" />
                                <TextBlock x:Name="FocusRingCaption" Text="left" Foreground="#9A9AA3" FontSize="10.5"
                                           HorizontalAlignment="Center" Margin="0,-1,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="FocusChip" HorizontalAlignment="Left" CornerRadius="10" Padding="9,2.5"
                                    Background="#33FF6A3D">
                                <TextBlock x:Name="FocusPhase" FontSize="10.5" FontWeight="Bold" Foreground="#FF6A3D" />
                            </Border>
                            <TextBlock x:Name="FocusTitle" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FocusSub" Foreground="#9A9AA3" FontSize="12.5"
                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            <StackPanel x:Name="FocusDots" Orientation="Horizontal" Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Compact: artwork, title, equaliser -->
                <Grid x:Name="CompactView" Width="230" Height="36"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ArtSmall" Grid.Column="0" Width="24" Height="24"
                            CornerRadius="7" Margin="7,0,0,0" Background="#2A2A2E" />

                    <TextBlock x:Name="TitleSmall" Grid.Column="1" Foreground="White"
                               FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel x:Name="Equaliser" Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Height="14" Margin="0,0,12,0">
                        <Rectangle x:Name="Bar1" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF5F7A" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Rectangle x:Name="Bar2" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF5F7A" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Rectangle x:Name="Bar3" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF5F7A" VerticalAlignment="Center" Margin="0,0,2,0" />
                        <Rectangle x:Name="Bar4" Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Fill="#FF5F7A" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Expanded: artwork, track details, controls, progress -->
                <Grid x:Name="ExpandedView" Width="400" Height="132"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False">
                    <Grid Margin="20,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ArtLarge" Grid.Column="0" Width="64" Height="64"
                                    CornerRadius="14" Background="#2A2A2E" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock x:Name="TitleLarge" Foreground="White" FontSize="15"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ArtistLarge" Foreground="#9A9AA3" FontSize="12.5"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous" />
                                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE769;" Click="PlayPause_Click" ToolTip="Play / Pause" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Next" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="CurrentTime" Grid.Column="0" Text="0:00" Foreground="#9A9AA3" FontSize="10.5" VerticalAlignment="Center" />

                            <Border x:Name="ProgressTrack" Grid.Column="1" Height="4" CornerRadius="2"
                                    Background="#2A2A2E" Margin="8,0" VerticalAlignment="Center"
                                    SizeChanged="ProgressTrack_SizeChanged">
                                <Border x:Name="ProgressFill" Width="0" CornerRadius="2"
                                        Background="White" HorizontalAlignment="Left" />
                            </Border>

                            <TextBlock x:Name="TotalTime" Grid.Column="2" Text="0:00" Foreground="#9A9AA3" FontSize="10.5" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Page dots: only when both media and a Clock session are active (expanded) -->
                <StackPanel x:Name="Pager" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,4,0,0" Visibility="Collapsed">
                    <Border Padding="5,3" Cursor="Hand" Background="Transparent"
                            MouseLeftButtonUp="PagerMedia_Click" ToolTip="Media">
                        <Ellipse x:Name="PagerMediaDot" Width="6" Height="6" Fill="White" />
                    </Border>
                    <Border Padding="5,3" Cursor="Hand" Background="Transparent"
                            MouseLeftButtonUp="PagerFocus_Click" ToolTip="Focus">
                        <Ellipse x:Name="PagerFocusDot" Width="6" Height="6" Fill="#46464F" />
                    </Border>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
