<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings"
        Width="480" Height="460"
        MinWidth="400" MinHeight="360"
        Background="#111114"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        SourceInitialized="Window_SourceInitialized">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,24,0,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1C1C21" />
            <Setter Property="BorderBrush" Value="#2A2A31" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AA3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <TextBlock Text="Settings" Foreground="White" FontSize="24" FontWeight="SemiBold" />

            <!-- GENERAL -->
            <TextBlock Text="GENERAL" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Launch the island automatically when you sign in." Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="StartupToggle" Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}" Click="StartupToggle_Click"
                                  AutomationProperties.Name="Start with Windows" />
                </Grid>
            </Border>

            <!-- ISLAND -->
            <TextBlock Text="ISLAND" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Expand when you" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Hover expands as soon as the mouse is over the island. Click needs a click." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#26262C" CornerRadius="10" Padding="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HoverOption" GroupName="Trigger" Content="Hover"
                                             Style="{StaticResource SegmentButton}" Click="TriggerOption_Click" />
                                <RadioButton x:Name="ClickOption" GroupName="Trigger" Content="Click"
                                             Style="{StaticResource SegmentButton}" Click="TriggerOption_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="1" Background="#2A2A31" />

                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Pop up on track change" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Briefly expand the island when the song changes." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <ToggleButton x:Name="AutoPopToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Click="AutoPopToggle_Click"
                                      AutomationProperties.Name="Pop up on track change" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- INTEGRATIONS -->
            <TextBlock Text="INTEGRATIONS" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <Grid Margin="16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Sync Microsoft Clock" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Show Focus sessions and timers from the Windows Clock app. Clock must be open on screen, not minimized. Only the countdown is read, never your tasks." Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ToggleButton x:Name="SyncClockToggle" Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}" Click="SyncClockToggle_Click"
                                  AutomationProperties.Name="Sync Microsoft Clock" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Claude Code status" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Show your Claude Code sessions: what each is doing, how long, and when it needs you. Read-only." Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <ToggleButton x:Name="AgentToggle" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}" Click="AgentToggle_Click"
                                      AutomationProperties.Name="Claude Code status" />
                    </Grid>

                    <Border Height="1" Background="#2A2A31" />

                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="HookStatusTitle" Text="Claude Code hooks" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="HookStatusHint" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <Button x:Name="HookButton" Grid.Column="1" VerticalAlignment="Center"
                                Style="{StaticResource PillButton}" Click="HookButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
