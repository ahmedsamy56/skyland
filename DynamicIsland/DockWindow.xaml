<Window x:Class="DynamicIsland.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SkyLand"
        Width="52" Height="52"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SourceInitialized="Window_SourceInitialized">

    <!-- The minimized island: a small round icon with the SkyLand logo. A colored ring around its edge shows what
         needs attention (amber = Claude needs you, orange = microphone, green = camera). Click it to bring the
         island back; drag it along a screen edge to move it. The window is 52 px so the ring has room. -->
    <Grid Width="52" Height="52" Cursor="Hand" Background="Transparent"
          MouseLeftButtonDown="Icon_MouseLeftButtonDown"
          MouseMove="Icon_MouseMove"
          MouseLeftButtonUp="Icon_MouseLeftButtonUp">

        <Ellipse Width="44" Height="44" Fill="Black" />
        <Ellipse Width="44" Height="44" Stroke="#2A2A30" StrokeThickness="3" />

        <!-- Colored arcs, built in code -->
        <Grid x:Name="RingHost" Width="44" Height="44" IsHitTestVisible="False" />

        <Viewbox Width="26" IsHitTestVisible="False">
            <!-- The SkyLand artwork, drawn from its original coordinates (shapes are shared resources in App.xaml) -->
            <Canvas Width="501.11" Height="276.14">
                <Canvas.RenderTransform>
                    <TranslateTransform X="-506.8" Y="-291.96" />
                </Canvas.RenderTransform>
                <Path Data="{StaticResource LogoShape1}" Fill="#2563eb" Stroke="#2563eb" StrokeThickness="1" StrokeLineJoin="Round" />
                <Path Data="{StaticResource LogoShape2}" Fill="#ffffff" Stroke="#eeeeee" StrokeThickness="1" StrokeLineJoin="Round" />
                <Path Data="{StaticResource LogoShape3}" Fill="#62abf7" />
                <Path Data="{StaticResource LogoShape4}" Fill="#e5effc" />
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
