<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Product identity. Code namespaces and project names keep their original names on purpose. -->
    <AssemblyName>SkyLand</AssemblyName>
    <Product>SkyLand</Product>
    <Company>SkyZack</Company>
    <Description>SkyLand, a Dynamic Island for Windows 11</Description>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\skyland.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded, so the tray and the Settings window can load it. -->
    <Resource Include="Assets\skyland.ico" />
  </ItemGroup>

  <!-- The Claude Code hook tool ships in a "hook" folder next to the island. Build it with the island
       and copy it on build and on publish. It is built without the island's runtime identifier. -->
  <ItemGroup>
    <ProjectReference Include="..\DynamicIsland.Hook\DynamicIsland.Hook.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </ItemGroup>

  <Target Name="CopyHookTool" AfterTargets="Build;Publish">
    <ItemGroup>
      <HookFile Include="..\DynamicIsland.Hook\bin\$(Configuration)\net8.0\island-hook.*" />
    </ItemGroup>
    <PropertyGroup>
      <HookTarget Condition="'$(PublishDir)' != '' and '$(_IsPublishing)' == 'true'">$(PublishDir)hook</HookTarget>
      <HookTarget Condition="'$(HookTarget)' == ''">$(OutDir)hook</HookTarget>
    </PropertyGroup>
    <Copy SourceFiles="@(HookFile)" DestinationFolder="$(HookTarget)" />
  </Target>

  <ItemGroup>
    <!-- GPU load comes from the Windows "GPU Engine" performance counters. -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing names from clashing with WPF types (Application, Button, Brush...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
